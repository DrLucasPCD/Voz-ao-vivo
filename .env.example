# Configure estas variáveis apenas no ambiente do Netlify. Nunca envie a chave real ao GitHub.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
ALLOWED_FIREBASE_EMAILS=seu-email-autorizado@exemplo.com
# Alternativa ao e-mail: lista de UIDs Firebase separados por vírgula.
ALLOWED_FIREBASE_UIDS=
NEXT_PUBLIC_ENABLE_APPLE_SIGN_IN=false
